Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormGadget
  #BtnApply
EndEnumeration


Procedure OpenFrmMain(x = 0, y = 0, width = 320, height = 220)
  OpenWindow(#FrmMain, x, y, width, height, "Main")
  ButtonGadget(#BtnApply, 10, 20, 80, 24, "Apply")
EndProcedure


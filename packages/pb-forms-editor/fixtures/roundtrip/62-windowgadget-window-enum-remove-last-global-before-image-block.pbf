Global winMain

Enumeration FormGadget
  #Image_0
EndEnumeration

Enumeration FormImage
  #Img_winMain_0
EndEnumeration

UsePNGImageDecoder()

LoadImage(#Img_winMain_0,"logo.png")


Procedure OpenwinMain(x = 0, y = 0, width = 220, height = 140)
  winMain = OpenWindow(#PB_Any, x, y, width, height, "Window Basic")
  ImageGadget(#Image_0, 41, 30, 49, 45, ImageID(#Img_winMain_0))
EndProcedure


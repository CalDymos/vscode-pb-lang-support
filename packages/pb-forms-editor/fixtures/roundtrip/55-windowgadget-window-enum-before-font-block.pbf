Global win

Global Text_0

Enumeration FormFont
  #Font_win_0
EndEnumeration

LoadFont(#Font_win_0,"Arial", 10)


Procedure Openwin(x = 0, y = 0, width = 220, height = 140)
  win = OpenWindow(#PB_Any, x, y, width, height, "Window Basic")
  Text_0 = TextGadget(#PB_Any, 38, 45, 83, 34, "")
  SetGadgetFont(Text_0, FontID(#Font_win_0))
EndProcedure


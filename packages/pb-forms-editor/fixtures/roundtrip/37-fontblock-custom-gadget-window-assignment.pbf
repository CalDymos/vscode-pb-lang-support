Global winMain

Global CustomGadget

; 0 Custom gadget initialisation (do Not remove this line)
InitMyCustomGadget()

Procedure OpenwinMain(x = 0, y = 0, width = 220, height = 140)
  winMain = OpenWindow(#PB_Any, x, y, width, height, "Fonts")

Global Font_FrmMain_0

Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormGadget
  #Button_0
EndEnumeration

Font_FrmMain_0 = LoadFont(#PB_Any,"Arial", 10)


Procedure OpenFrmMain(x = 0, y = 0, width = 220, height = 140)
  OpenWindow(#FrmMain, x, y, width, height, "Fonts")
  ButtonGadget(#Button_0, 64, 38, 64, 34, "")
  SetGadgetFont(#Button_0, FontID(Font_FrmMain_0))
EndProcedure




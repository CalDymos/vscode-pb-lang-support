Global FrmMain


Procedure OpenFrmMain(x = 0, y = 0, width = 320, height = 200)
  FrmMain = OpenWindow(#PB_Any, x, y, width, height, "Toolbar Only")
  CreateToolBar(0, WindowID(FrmMain))
  ToolBarSeparator()
EndProcedure


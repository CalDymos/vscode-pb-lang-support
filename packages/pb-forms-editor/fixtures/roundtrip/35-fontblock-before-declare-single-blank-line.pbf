Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormGadget
  #Text_0
EndEnumeration

Enumeration FormFont
  #Font_FrmMain_0
EndEnumeration

LoadFont(#Font_FrmMain_0,"Arial", 10)

Declare ResizeGadgetsFrmMain()


Procedure OpenFrmMain(x = 0, y = 0, width = 220, height = 140)
  OpenWindow(#FrmMain, x, y, width, height, "Fonts")
  TextGadget(#Text_0, 56, 49, 64, 23, "")
  SetGadgetFont(#Text_0, FontID(#Font_FrmMain_0))
EndProcedure

Procedure ResizeGadgetsFrmMain()
  Protected FormWindowWidth, FormWindowHeight
  FormWindowWidth = WindowWidth(#FrmMain)
  FormWindowHeight = WindowHeight(#FrmMain)
  ResizeGadget(#Text_0, 56, 65, FormWindowWidth - 156, 30)
EndProcedure


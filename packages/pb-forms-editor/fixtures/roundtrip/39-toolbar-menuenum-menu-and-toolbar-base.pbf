Global Img_FrmMain_0

Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormMenu
  #MenuOpen
  #TbSave
EndEnumeration

UsePNGImageDecoder()

Img_FrmMain_0 = LoadImage(#PB_Any,"save.png")


Procedure OpenFrmMain(x = 0, y = 0, width = 320, height = 200)
  OpenWindow(#FrmMain, x, y, width, height, "Menu and Toolbar")
  CreateToolBar(0, WindowID(#FrmMain))
  ToolBarImageButton(#TbSave,ImageID(Img_FrmMain_0))
  ToolBarToolTip(0, #TbSave, "Save")
  CreateMenu(0, WindowID(#FrmMain))
  MenuTitle("File")
  MenuItem(#MenuOpen, "Open")
EndProcedure


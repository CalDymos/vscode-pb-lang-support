; Form Designer for PureBasic - 6.30

Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormImage
  #ImgMainLogo
EndEnumeration

UsePNGImageDecoder()

LoadImage(#ImgMainLogo, "logo.png")

Procedure OpenFrmMain(x = 0, y = 0, width = 220, height = 140)
  OpenWindow(#FrmMain, x, y, width, height, "Fonts")
EndProcedure

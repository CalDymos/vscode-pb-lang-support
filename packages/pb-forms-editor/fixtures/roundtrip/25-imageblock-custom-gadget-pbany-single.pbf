Global Img_FrmMain_0

Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormGadget
  #Image_0
EndEnumeration

; 0 Custom gadget initialisation (do Not remove this line)
InitMyCustomGadget()

UsePNGImageDecoder()

Img_FrmMain_0 = LoadImage(#PB_Any,"logo.png")


Procedure OpenFrmMain(x = 0, y = 0, width = 220, height = 140)
  OpenWindow(#FrmMain, x, y, width, height, "Images")
  ; 0 Custom gadget creation (do not remove this line) MyCustomGadget(%id%, %x%, %y%, %w%, %h%, %txt%, %hWnd%)
  MyCustomGadget(#Custom_0, 0, 0, 0, 0, "", WindowID(#FrmMain))
  ImageGadget(#Image_0, 68, 38, 75, 38, ImageID(Img_FrmMain_0))
EndProcedure


Global win

Global img0

Enumeration FormImage
  #Img_win_0
EndEnumeration

UsePNGImageDecoder()

LoadImage(#Img_win_0,"logo.png")


Procedure Openwin(x = 0, y = 0, width = 220, height = 140)
  win = OpenWindow(#PB_Any, x, y, width, height, "Window Basic")
  img0 = ImageGadget(#PB_Any, 10, 10, 32, 32, ImageID(#Img_win_0))
EndProcedure


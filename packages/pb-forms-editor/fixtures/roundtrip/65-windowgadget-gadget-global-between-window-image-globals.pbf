Global winMain

Global gInput


Procedure OpenwinMain(x = 0, y = 0, width = 220, height = 140)
  winMain = OpenWindow(#PB_Any, x, y, width, height, "Window Basic")
  gInput = StringGadget(#PB_Any, 10, 36, 220, 24, "")
  ImageGadget(#PB_Any, 10, 70, 32, 32, 0)
EndProcedure


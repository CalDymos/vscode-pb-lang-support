Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormMenu
  #TbSave
EndEnumeration

Enumeration FormImage
  #Img_FrmMain_0
EndEnumeration

UsePNGImageDecoder()

LoadImage(#Img_FrmMain_0,"icons/save.png")


Procedure OpenFrmMain(x = 0, y = 0, width = 320, height = 220)
  OpenWindow(#FrmMain, x, y, width, height, "Toolbar")
  CreateToolBar(0, WindowID(#FrmMain))
  ToolBarImageButton(#TbSave,ImageID(#Img_FrmMain_0))
  ToolBarSeparator()
EndProcedure


Global Image_0

Global Img_FrmMain_0

Enumeration FormWindow
  #FrmMain
EndEnumeration

UsePNGImageDecoder()

Img_FrmMain_0 = LoadImage(#PB_Any,"logo.png")


Procedure OpenFrmMain(x = 0, y = 0, width = 220, height = 140)
  OpenWindow(#FrmMain, x, y, width, height, "Images")
  Image_0 = ImageGadget(#PB_Any, 49, 41, 56, 38, ImageID(Img_FrmMain_0))
EndProcedure


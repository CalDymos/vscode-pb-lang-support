Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormGadget
  #ButtonImage_0
EndEnumeration

Enumeration FormImage
  #Img_FrmMain_0
EndEnumeration

UsePNGImageDecoder()

LoadImage(#Img_FrmMain_0,"logo.png")

Enumeration FormFont
  #Font_FrmMain_0
EndEnumeration

LoadFont(#Font_FrmMain_0,"Arial", 10)


Procedure OpenFrmMain(x = 0, y = 0, width = 220, height = 140)
  OpenWindow(#FrmMain, x, y, width, height, "Images")
  ButtonImageGadget(#ButtonImage_0, 68, 49, 68, 26, ImageID(#Img_FrmMain_0))
  SetGadgetFont(#ButtonImage_0, FontID(#Font_FrmMain_0))
EndProcedure


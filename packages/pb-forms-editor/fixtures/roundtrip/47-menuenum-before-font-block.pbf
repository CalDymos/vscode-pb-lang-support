; Form Designer for PureBasic - 6.30

Enumeration FormFont
  #FontMain
EndEnumeration

LoadFont(#FontMain, "Arial", 10)

Procedure OpenFrmMain(x = 0, y = 0, width = 320, height = 200)
  OpenWindow(#PB_Any, x, y, width, height, "Menu")
  CreateMenu(0, WindowID(#PB_Any))
  MenuTitle("File")
EndProcedure

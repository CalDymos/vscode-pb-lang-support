Global FrmMain

Global Editor1

Enumeration FormFont
  #Font_FrmMain_0
EndEnumeration

LoadFont(#Font_FrmMain_0,"Arial", 10)


Procedure OpenFrmMain(x = 0, y = 0, width = 320, height = 200)
  FrmMain = OpenWindow(#PB_Any, x, y, width, height, "Menu")
  CreateMenu(0, WindowID(FrmMain))
  MenuTitle("File")
  Editor1 = EditorGadget(#PB_Any, 4, 4, 311, 176)
  SetGadgetFont(Editor1, FontID(#Font_FrmMain_0))
EndProcedure


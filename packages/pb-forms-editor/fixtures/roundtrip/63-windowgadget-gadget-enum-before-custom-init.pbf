Enumeration FormWindow
  #FrmMain
EndEnumeration

Enumeration FormGadget
  #BtnOk
  #Custom
EndEnumeration

; 1 Custom gadget initialisation (do Not remove this line)
InitMyCustomGadget()


Procedure OpenFrmMain(x = 0, y = 0, width = 220, height = 140)
  OpenWindow(#FrmMain, x, y, width, height, "Window Basic")
  ButtonGadget(#BtnOk, 10, 10, 80, 24, "OK")
  ; 1 Custom gadget creation (do not remove this line) MyCustomGadget(%id%, %x%, %y%, %w%, %h%, %txt%, %hwnd%)
  MyCustomGadget(#Custom, 0, 0, 0, 0, "Custom", WindowID(#FrmMain))
EndProcedure

